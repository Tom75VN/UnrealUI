core\talentgrid.lua
core\dropdown.lua
core\screenguard.lua
core\mover.lua

# The contextual settings panel that follows the selected mover in edit mode.
# A module registers what goes in it for its own mover id; this file owns the
# window, its placement beside the handle and its show/hide lifecycle.
core\moverpanel.lua

# Placeholder content for anchors that are empty while edit mode is open (an
# unsummoned pet bar, the tooltip guide, undamaged armour, an aura row with no
# auras). Loaded after core\mover.lua because it is driven from the handle
# show/hide path, and before any module that registers a sample.
core\moversample.lua
core\windowdrag.lua
core\commands.lua

