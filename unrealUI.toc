core\init.lua

# Translation layer. locale.lua only needs the UnrealUI table, and every
# locales\ file only needs U.RegisterLocale, so both load before anything that
# might want a string. The language itself is not selected here: U.LoadLanguage
# runs from core/init.lua once SavedVariables are readable.
core\locale.lua
locales\enUS.lua
locales\zhCN.lua
locales\ruRU.lua
locales\frFR.lua

core\perf.lua
core\media.lua
core\theme.lua
themes\modern.lua
themes\classic-wow.lua
themes\modern-wow.lua

# Unit-frame styles. A theme decides which interface is drawn; a unit-frame
# style decides how UnrealUI's own frames look once it draws them. Registered
# after the themes because the selector only applies under the Modern theme.
core\unitframestyle.lua
core\auradata.lua
core\hotdata.lua
core\pricedata.lua

# Bundled VMaNGOS world data. Both tables hang off the addon table the way
# core\pricedata.lua does, so unrealUI owns them outright and exact vitals work
# with no sibling addon installed. core\unitvitals.lua is the code that reads
# them, and needs U.Round from core\compat.lua only at call time.
#
# The three name files are alternatives, not additions: each one returns at its
# first line unless GetLocale names it, so exactly one builds a table and the
# order they are listed in here does not decide which. The creature names have
# to follow the client's locale because they are matched against UnitName.
Database\unit_vitals.lua
Database\unit_names.lua
Database\unit_names_ruRU.lua
Database\unit_names_zhCN.lua
core\unitvitals.lua

core\compat.lua
core\weapons.lua
core\config.lua
core\style.lua
core\easing.lua
core\statusbarfx.lua
core\itemslot.lua
core\itemcategory.lua
core\itemsort.lua
core\widgets.lua
core\stockui.lua
core\dropdown.lua
core\mover.lua

# The contextual settings panel that follows the selected mover in edit mode.
# A module registers what goes in it for its own mover id; this file owns the
# window, its placement beside the handle and its show/hide lifecycle.
core\moverpanel.lua

# Placeholder content for anchors that are empty while edit mode is open (an
# unsummoned pet bar, the tooltip guide, undamaged armour, an aura row with no
# auras). Loaded after core\mover.lua because it is driven from the handle
# show/hide path, and before any module that registers a sample.
core\moversample.lua
core\windowdrag.lua
core\commands.lua

