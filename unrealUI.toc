# The HUD bag bar. Loaded after modules\bags.lua because it stands in for
# it: it builds nothing at all unless that module is switched off, and it
# reads the same persisted flag to decide.
modules\bagbar.lua
modules\bankcount.lua
modules\bank.lua
modules\bankview.lua
modules\status.lua

# The Quest Log's Dragonflight design, as its own module: the page art's two
# panes, the action-button beds, the native scroll bars in their channels, the
# count boxes, the parchment ink and the scrolling reward-money row. Entry
# points only -- modules\questlog.lua binds the window and calls them, for the
# full Modern WoW theme or Classic's explicit Quest Log selection, so both
# themes draw this one file. Loaded before that module for the same reason
# modules\bagdesign.lua precedes modules\bags.lua.
modules\questlogdesign.lua
modules\questlog.lua

# The Classic WoW theme's two-page parchment Quest Log (classic-wow layout).
# Loaded right after modules\questlog.lua because the two are the same
# surface under different themes: that module builds nothing under native
# chrome, this one builds nothing under anything else. Before
# modules\windowmove.lua so the window is already at its extended size
# when the drag header is measured.
modules\questlogextended.lua
modules\spellbook.lua

# The Spellbook's modern-wow drawing path. Defines entry points only;
# modules\spellbook.lua decides in its own OnEnable whether to call them, for
# the full Modern WoW theme or Classic's explicit Spellbook selection.
modules\spellbookmodernwow.lua
# Shared Professions-tab behavior and data for each Spellbook drawing path.
modules\spellbookprofessions.lua
# The same page under the flat Modern theme: shared behavior, modern tabs and
# reversible placement of the native profession spell buttons.
modules\spellbookmodernprof.lua
# The classic-wow Spellbook's "Not on action bars" glow. Entry point only;
# modules\spellbook.lua calls it when the modern-wow book is not drawn.
modules\spellbookclassicglow.lua
# The classic-wow native Spellbook's Spellbook / Professions tabs and the host
# for the Professions page above. Entry point only; modules\spellbook.lua
# builds it on classic-wow's native chrome path.
modules\spellbookclassicprof.lua

# The optional talent build drawer, shared by every path below and named by
# whichever one builds: it binds a highlight to every talent button as that
# button is created, so it has to load first. Entry points only.
modules\talentadvisor.lua

# The Talent window's three complete drawing paths: DF-main's three-panel
# frame for modern-wow, the same three-tree interface in the modern theme's
# own flat language, and the same interface again in the client's own chrome
# for classic-wow. Entry points only; modules\talents.lua picks one.
modules\talentsmodernwow.lua
modules\talentsmodern.lua
modules\talentsclassic.lua
modules\talents.lua

# The profession (TradeSkill / Craft) window's two complete drawing paths:
# UnrealUI's flat interface for modern, then DF-main's profession frame for
# modern-wow (also used by Classic's explicit Crafting selection). After
# spellbookprofessions.lua and talentsmodernwow.lua, whose shared profession
# lookup and panel rim it calls, and before modules\modernwow.lua, which
# checks that it built.
modules\professionsmodern.lua
modules\professions.lua
# The tracked-recipe HUD the profession window's "Track this recipe" box
# feeds. Theme-independent; professions.lua only calls its U.* entry points.
modules\crafttracker.lua
modules\character.lua
modules\inspect.lua
modules\friends.lua
modules\merchant.lua
modules\trainer.lua
modules\mail.lua
# The quest giver's Modern WoW design for QuestFrame and GossipFrame (the
# `questdialog` surface): entry points only, bound and called by
# modules\gossip.lua and modules\quest.lua.
modules\questdesign.lua
modules\gossip.lua
modules\quest.lua
modules\windowmove.lua

# The modern-wow theme's own drawing path. Last on purpose: it dresses
# frames the modules above own, so every one of them has already been
# built by the time its OnEnable runs. Classic can route only its selected
# modules through the same complete drawing paths.
modules\modernwow.lua
