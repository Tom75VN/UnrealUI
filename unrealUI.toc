# The HUD bag bar. Loaded after modules\bags.lua because it stands in for
# it: it builds nothing at all unless that module is switched off, and it
# reads the same persisted flag to decide.
modules\bagbar.lua
modules\bankcount.lua
modules\bank.lua
modules\status.lua
modules\questlog.lua

# The Classic WoW theme's two-page parchment Quest Log (classic-wow layout).
# Loaded right after modules\questlog.lua because the two are the same
# surface under different themes: that module builds nothing under native
# chrome, this one builds nothing under anything else. Before
# modules\windowmove.lua so the window is already at its extended size
# when the drag header is measured.
modules\questlogextended.lua
modules\spellbook.lua

# The Spellbook's modern-wow drawing path. Defines entry points only;
# modules\spellbook.lua decides in its own OnEnable whether to call them, for
# the full Modern WoW theme or Classic's explicit Spellbook selection.
modules\spellbookmodernwow.lua
# Its Professions tab and page. Built only by that drawing path.
modules\spellbookprofessions.lua
# The classic-wow Spellbook's "Not on action bars" glow. Entry point only;
# modules\spellbook.lua calls it when the modern-wow book is not drawn.
modules\spellbookclassicglow.lua
# The classic-wow native Spellbook's Spellbook / Professions tabs and the host
# for the Professions page above. Entry point only; modules\spellbook.lua
# builds it on classic-wow's native chrome path.
modules\spellbookclassicprof.lua

# The Talent window's two complete drawing paths: DF-main's three-panel
# frame for modern-wow, and the same three-tree interface in the modern
# theme's own flat language. Entry points only; modules\talents.lua
# picks one.
modules\talentsmodernwow.lua
modules\talentsmodern.lua
modules\talents.lua

# The profession (TradeSkill / Craft) window's modern-wow drawing path
# (DF-main's profession frame). Also serves Classic's explicit Crafting
# selection and otherwise builds nothing. After
# spellbookprofessions.lua and talentsmodernwow.lua, whose shared profession
# lookup and panel rim it calls, and before modules\modernwow.lua, which
# checks that it built.
modules\professions.lua
# The tracked-recipe HUD the profession window's "Track this recipe" box
# feeds. Theme-independent; professions.lua only calls its U.* entry points.
modules\crafttracker.lua
